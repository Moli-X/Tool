# 规则名称: QQMail
# 规则统计: 14


  - DOMAIN-SUFFIX,dl.mail.qq.com          # 附件下载,QQMail
  - DOMAIN-SUFFIX,dl.mail.qq.com          # 附件下载payload:,QQMail
  - DOMAIN-SUFFIX,exmail.qq.com           # 企业邮箱网页版,QQMail
  - DOMAIN-SUFFIX,imap.qq.com             # IMAP服务（收邮件）,QQMail
  - DOMAIN-SUFFIX,img.mail.qq.com         # 邮箱图标资源,QQMail
  - DOMAIN-SUFFIX,mail.qpic.cn            # 邮件中加载图片、附件,QQMail
  - DOMAIN-SUFFIX,mail.qq.com             # QQ邮箱网页版主域,QQMail
  - DOMAIN-SUFFIX,pop.qq.com              # POP3服务,QQMail
  - DOMAIN-SUFFIX,push.mail.qq.com        # 推送服务,QQMail
  - DOMAIN-SUFFIX,smtp.qq.com             # SMTP服务（发邮件）,QQMail
  - DOMAIN-SUFFIX,wx.mail.qq.com          # QQ邮箱网页版微信相关,QQMail
# NAME: QQ邮箱
payload:,QQMail

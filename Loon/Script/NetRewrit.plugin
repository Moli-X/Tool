#!name=资源预览
#!desc=预览插件中心资源
#!openUrl=https://hub.kelee.one/index.html
#!author=Moli-X[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md], 插件Hub[https://hub.kelee.one/index.html],插件Lab[https://loonlab.103516.xyz/Plugin/index.html]
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Script/NetRewrit.plugin
#!icon=https://github.com/Moli-X/Resources/raw/main/Icon/Image/Moli.png
#!tag=功能增强


[Rewrite]


# kelee
^https:\/\/(.*\.)?kelee\.one(\/.*)? header-replace User-Agent Surge\x20iOS/9527
^https:\/\/(.*\.)?kelee\.one(\/.*)? response-header-replace content-disposition inline
^https:\/\/(.*\.)?kelee\.one(\/.*)? response-header-replace content-type text/plain; charset=utf-8

# loon
^https:\/\/(.*\.)?loon\.103516\.xyz(\/.*)? header-replace User-Agent Surge\x20iOS/9527
^https:\/\/(.*\.)?loon\.103516\.xyz(\/.*)? response-header-replace content-disposition inline
^https:\/\/(.*\.)?loon\.103516\.xyz(\/.*)? response-header-replace content-type text/plain; charset=utf-8


[MITM]
hostname = kelee.one, *.kelee.one, loon.103516.xyz, *.loon.103516.xyz

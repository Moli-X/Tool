#!name=资源预览
#!desc=预览插件中心资源
#!openUrl=https://hub.kelee.one/index.html
#!author=Moli-X[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md], 插件仓库[https://hub.kelee.one/index.html],插件仓库[https://loonlab.103516.xyz/Plugin/index.html]
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Script/NetRewrit.plugin
#!icon=https://github.com/Moli-X/Resources/raw/main/Icon/Image/Moli.png
#!tag=功能增强

[Argument]
hub_exclude = switch,true,false,tag=中心排除

[Rewrite]
# kelee 主域（永远生效）
^https:\/\/(.*\.)?kelee\.one(\/.*)? header-replace User-Agent Surge\x20iOS/9527
^https:\/\/(.*\.)?kelee\.one(\/.*)? response-header-replace content-disposition inline
^https:\/\/(.*\.)?kelee\.one(\/.*)? response-header-replace content-type text/plain;\x20charset=utf-8

# hub（只有开关关闭时才生效）
^https:\/\/hub\.kelee\.one(\/.*)? header-replace User-Agent Surge\x20iOS/9527 enable={hub_exclude}
^https:\/\/hub\.kelee\.one(\/.*)? response-header-replace content-disposition inline enable={hub_exclude}
^https:\/\/hub\.kelee\.one(\/.*)? response-header-replace content-type text/plain;\x20charset=utf-8 enable={hub_exclude}

# loon.103516.xyz（新增）
^https:\/\/(.*\.)?loon\.103516\.xyz(\/.*)? header-replace User-Agent Surge\x20iOS/9527
^https:\/\/(.*\.)?loon\.103516\.xyz(\/.*)? response-header-replace content-disposition inline
^https:\/\/(.*\.)?loon\.103516\.xyz(\/.*)? response-header-replace content-type text/plain;\x20charset=utf-8

[MITM]
hostname = kelee.one, *.kelee.one, loon.103516.xyz, *.loon.103516.xyz

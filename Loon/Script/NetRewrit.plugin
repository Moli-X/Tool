#!name=资源预览
#!desc=预览插件中心资源
#openUrl=https://hub.kelee.one/index.html
#!author=Moli-X[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md], 插件Hub[https://hub.kelee.one/index.html],插件Lab[https://loonlab.103516.xyz/Plugin/index.html]
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Script/NetRewrit.plugin
#!icon=https://github.com/Moli-X/Resources/raw/main/Icon/Image/Moli.png
#!tag=功能增强


[Rewrite]

^https:\/\/((?!hub\.kelee\.one)(.*\.)?kelee\.one)(\/.*)? header-replace User-Agent Surge\x20iOS/9527
^https:\/\/((?!hub\.kelee\.one)(.*\.)?kelee\.one)(\/.*)? response-header-replace content-disposition inline
^https:\/\/((?!hub\.kelee\.one)(.*\.)?kelee\.one)(\/.*)? response-header-replace content-type application/json;\x20charset=utf-8

^https:\/\/(.*\.)?loon\.103516\.xyz(\/.*)? header-replace User-Agent Surge\x20iOS/9527
^https:\/\/(.*\.)?loon\.103516\.xyz(\/.*)? response-header-replace content-disposition inline
^https:\/\/(.*\.)?loon\.103516\.xyz(\/.*)? response-header-replace content-type application/json;\x20charset=utf-8

^https:\/\/(.*\.)?github\.669697\.xyz(\/.*)? header-replace User-Agent Surge\x20iOS/9527
^https:\/\/(.*\.)?github\.669697\.xyz(\/.*)? response-header-replace content-disposition inline
^https:\/\/(.*\.)?github\.669697\.xyz(\/.*)? response-header-replace content-type application/json;\x20charset=utf-8

^https:\/\/(.*\.)?git\.repcz\.link(\/.*)? header-replace User-Agent Surge\x20iOS/9527
^https:\/\/(.*\.)?git\.repcz\.link(\/.*)? response-header-replace content-disposition inline
^https:\/\/(.*\.)?git\.repcz\.link(\/.*)? response-header-replace content-type application/json;\x20charset=utf-8

^https:\/\/raw\.githubusercontent\.com\/(?!.*\.(png|jpg|jpeg|gif|webp)$).* response-header-replace content-disposition inline
^https:\/\/raw\.githubusercontent\.com\/(?!.*\.(png|jpg|jpeg|gif|webp)$).* response-header-replace content-type application/json;\x20charset=utf-8



[MITM]
hostname = kelee.one, *.kelee.one, loon.103516.xyz, *.loon.103516.xyz, raw.githubusercontent.com, script.hub, git.repcz.link, github.669697.xyz

#!name=高德地图去广告
#!desc=移除高德地图开屏广告、各页面推广，精简我的页面及配置文件。
#App链接=https://apps.apple.com/app/id461703208
#!author=可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Amap_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Amap.png
#!date=2026-10-19 00:01:27

[Rewrite]
^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\? response-body-json-del data.adStatementConfig data.adCustomerRetainArchitecture data.adImEntryConfig data.adVenueConfig data.adPerfSwitch data.EndNaviC3AdCard data.infoCpcReport data.hotsaleConfig data.marketing_resource_config data.coupon_risk_asac data.commonCouponSceneLog data.sug_coupon_opt data.giftEntryConfig data.splashscreen data.SplashScreenControl data.splashview_config data.feedback_banner data.TrainOrderBanner data.nearby_business_popup data.shortcut_popup_frequency data.tel_retention_popup data.hotel_activity data.taxi_activity data.hotel_privilege data.sportsActivityConfig data.activity_qingke_contry_control data.920bestwishes data.custom_consultdata.widget_guide data.free_ride data.homepage_resource_config data.home_message_guide data.hotel_tipsicon data.sur_bar data.nearby_map_entry_guide data.comment_info data.small_biz_index data.small_biz_fun data.setpagesearch data.wallet

^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\? response-body-json-jq jq-path="http://10.0.0.1:5000/updatable.jq"

^https:\/\/m5\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv3\? response-body-json-jq 'del(.data.tipData, .data.wallet) | .data.cardList |= map(select(.dataKey == "MineNewFootprintCard" or .dataKey == "MineNewBEntranceCardV4")) | (.data.cardList[] | select(.dataKey == "MineNewBEntranceCardV4") | .content.entranceList_1) |= map(select(.id == 7 or .id == 8 or .id == 10 or .id == 17)) | (.data.cardList[] | select(.dataKey == "MineNewBEntranceCardV4") | .content.entranceList_2) |= map(select(.id == 32 or .id == 4 or .id == 9 or .id == 16 or .id == 14))'

^https:\/\/m5\.amap\.com\/ws\/shield\/scene\/recommend\? response-body-json-del $.data.shadingWords
^https:\/\/m5\.amap\.com\/ws\/shield\/scene\/recommend\? response-body-json-jq '.data.toolsRecommend.data.default |= map(select(.id == 102 or .id == 103 or .id == 106 or .id == 151))'

^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-assets\? reject-dict
^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-aiqs\? reject-dict

^https:\/\/ai\.amap\.com\/v1\/ai_rec\/home_qs\? reject-dict

^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource(\/home)?\? reject-dict

^https:\/\/m5-zb\.amap\.com\/ws\/boss\/car\/order\/content_info\? response-body-json-del data.lubanData.skin

[MitM]
hostname=m5.amap.com, ai.amap.com, m5-zb.amap.com
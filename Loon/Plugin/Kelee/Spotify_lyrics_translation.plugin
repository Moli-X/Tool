#!name=Spotify歌词增强
#!desc=将Spotify的外语歌词翻译为简体中文，并提供双语翻译支持。
#App链接=https://apps.apple.com/app/id324684580
#!author=VirgilClyne[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=功能增强
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Spotify_lyrics_translation.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png
#!date=2026-10-02 13:57:49

[Script]
response if ${url} ~= /^https?:\/\/api\.spotify\.com\/v1\/tracks\?/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/Spotify_response.js") with tag="跟踪响应·JSON", requires_body=true

request if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/Spotify_request.js") with tag="歌词请求·JSON", requires_body=true
request if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/Spotify_request.js") with tag="歌词请求·Proto", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=Translate/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/Translate_response.js") with tag="翻译歌词响应·JSON", requires_body=true
response if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=Translate/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/Translate_response.js") with tag="翻译歌词响应·Proto", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=External/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/External_Lyrics_response.js") with tag="外部歌词响应·JSON", requires_body=true
response if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=External/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/External_Lyrics_response.js") with tag="外部歌词响应·Proto", requires_body=true, binary_body_mode=true

[MitM]
hostname=api.spotify.com, spclient.wg.spotify.com
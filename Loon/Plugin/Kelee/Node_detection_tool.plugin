#!name=节点检测工具
#!desc=适用于Loon的节点检测工具，可进行地理位置、节点解锁、入口落地等查询。请在所有节点页面选择一个节点长按，出现菜单后进行测试。
#App链接=
#!author=xream[https://github.com/xream], Keywos[https://github.com/Keywos], KOP-XIAO[https://github.com/KOP-XIAO], dcpengx[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=节点检测
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Node_detection_tool.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/Node_detection_tool.png
#!date=2026-10-02 13:57:49

[Script]
generic then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/NetworkEntryAndExitQueries.js") with tag="入口落地查询", img_url="globe.asia.australia.system", timeout=10
generic then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/LocationDetection.js") with tag="地理位置查询", img_url="location.circle.system", timeout=10
generic then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/NodeUnlockDetection.js") with tag="节点解锁查询", img_url="play.circle.system", timeout=20
#!name=中国人保去广告
#!desc=移除中国人保开屏广告和应用内广告
#App链接=https://apps.apple.com/app/id710189980
#!author=Sliverkiss[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/PICC_Insurance_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PICC_Insurance.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/h\/headlines\/queryHeadlines/i then reject(404)
request if ${url} ~= /^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/update\/startupPage\/v1/i then reject_dict(200)
request if ${url} ~= /^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/config\/guessYouLike\/v3/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/config\/homeInit\/v3/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/PICC_Insurance_remove_ads.js") with tag="移除主页推广", requires_body=true

response if ${url} ~= /^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/mpageconfig\/myPageConfigList\/v3/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/PICC_Insurance_remove_ads.js") with tag="移除我的页面推广", requires_body=true

[MitM]
hostname=zgrb.epicc.com.cn
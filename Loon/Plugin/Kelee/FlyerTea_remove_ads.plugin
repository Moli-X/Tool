#!name=飞客去广告
#!desc=移除开屏广告、首页广告、板块广告、帖内广告和我的页面广告。
#App链接=https://apps.apple.com/app/id547560608
#!author=可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/FlyerTea_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/FlyerTea.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=advis/i then reject(404)
request if ${url} ~= /^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=vip_coupon/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ptf\.flyertrip\.com\/static\/img\/common\/ic_plate_mine_button\.png/i then reject_img(200)
request if ${url} ~= /^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=getdata/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?version=5/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/FlyerTea_remove_ads.js") with tag="移除板块广告", requires_body=true
response if ${url} ~= /^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=plugin&id=k_misign:sign/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/FlyerTea_remove_ads.js") with tag="移除签到弹窗广告", requires_body=true

[MitM]
hostname=www.flyert.com.cn, ptf.flyertrip.com
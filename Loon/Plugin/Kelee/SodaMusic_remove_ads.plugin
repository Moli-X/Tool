#!name=汽水音乐去广告
#!desc=移除开屏广告、弹窗广告、播放器推广、歌曲详情界面视频推广、播放页面的歌曲视频，精简首页和我的页面。
#App链接=https://apps.apple.com/app/id1605585211
#!author=可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/SodaMusic_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/SodaMusic.png
#!date=2026-10-02 13:57:49

[Rewrite]
response if ${url} ~= /^https:\/\/tnc\d-(bjlgy|ali[a-z]{2})\d?\.zijieapi\.com\/get_domains\/v\d\/\?/i then response.json.replace(["data.opaque_data_enabled", "data.ttnet_http_dns_enabled", "data.ttnet_quic_enabled", "data.ttnet_tt_http_dns"], [0, 0, 0, 0])

response if ${url} ~= /^https:\/\/tnc\d-(bjlgy|ali[a-z]{2})\d?\.zijieapi\.com\/get_domains\/v\d\/\?/i then response.json.jq(".data.ttnet_dispatch_actions |= map(select(.action != \"dispatch\" and .action != \"tc\"))")

request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/commerce\/upsells_config\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/(api|api5-lq)\.qishui\.com\/luna\/ads\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/ads\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/webcast-open\.douyin\.com\/webcast\/openapi\/feed\/\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/treasure\/entrance\/config\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/me\?/i then response.json.delete("reward_ad_banner")

request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/activities\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/feed\/song-tab\?/i then response.json.jq("del(.items[] | select(.type == \"video_track_mix\"))")

response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/card\?/i then response.json.delete("preview_guide")

response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/card\?/i then response.json.jq("del(.card_items[] | select(has(\"priority_display\")))")

request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/media_ads\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/more-panel\?/i then response.json.jq(".blocks |= map(select(.type != \"related_video\"))")

request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/commerce\/upsells\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/commerce\/v2\/commerce_info\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/listen-video\/reminder\?/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/me\/recently-played-media\?/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/SodaMusic_remove_ads.js") with tag="移除播放页面视频流", requires_body=true

[MitM]
hostname=webcast-open.douyin.com, beta-luna.douyin.com, api.qishui.com, api5-lq.qishui.com, tnc*-*.zijieapi.com
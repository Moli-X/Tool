#!name=健康160去广告
#!desc=移除开屏广告、应用内悬浮窗、弹窗广告、横幅广告，精简我的页面。
#App链接=https://apps.apple.com/app/id593811445
#!author=可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/91160_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/91160.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/msglb\.91160\.com\/msg\/outer\/broker\/get$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/patientgate\.91160\.com\/advert-api\//i then reject_dict(200)

response if ${url} ~= /^https:\/\/soapi\.91160\.com\/homepage-recommendation\/recommendation\/medical\/complex\?/i then response.json.delete("data.checkupList")

response if ${url} ~= /^https:\/\/soapi\.91160\.com\/homepage-recommendation\/homepage\/flow\?/i then response.json.jq(".data.rows |= map(select(.type as $type | [\"GOOD\", \"ARTICLE\"] | index($type) | not))")

response if ${url} ~= /^https:\/\/patientgate\.91160\.com\/cube\/v1\/unit_page\/page_data\?/i then response.json.jq(".data.modules |= map(select(.name == \"announcement\" or .name == \"guide\" or .name == \"expert\" or .name == \"featuredDepartments\" or .name == \"featureDevice\" or .name == \"featureTech\" or .name == \"familyDoctor\" or .name == \"introduction\" or .name == \"bus\" or .name == \"classicCase\" or .name == \"askEveryone\" or .name == \"reviews\" or .name == \"notes\"))")

request if ${url} ~= /^https:\/\/snsapi\.91160\.com\/vipmemberapi\/mbCombo\/mbComboWords\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/patientgate\.91160\.com\/rec\/homepage\/open\/getUserGoodsList\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/snsapi\.91160\.com\/hotword\/open\/v1\/getSearchExplore\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/snsapi\.91160\.com\/hotword\/open\/v1\/getHotWordPlate\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/snsapi\.91160\.com\/engine\/backgroundWord\/queryForFrontend\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/patientappapi\.91160\.com\/cus_index\.php\?c=adver/i then reject(404)

[MitM]
hostname=patientgate.91160.com, soapi.91160.com, snsapi.91160.com, msglb.91160.com, patientappapi.91160.com
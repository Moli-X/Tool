#!name=BoxJs
#!desc=JavaScript数据管理器，用于管理脚本储存的数据。使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#App链接=http://boxjs.com
#!author=chavyleung[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=数据管理
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/BoxJs.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/BoxJS.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN-SUFFIX, jsdelivr.net, PROXY

[Script]
request if ${url} ~= /^https?:\/\/(.+\.)?boxjs\.(com|net)/i then script("https://raw.githubusercontent.com/chavyleung/scripts/master/box/chavy.boxjs.js") with tag="BoxJS", timeout=120, requires_body=true

[MitM]
hostname=boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net
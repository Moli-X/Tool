[Script]
request if ${url} ~= /^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/JD_Price.js") with tag="捕获令牌", timeout=10, requires_body=true

response if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/JD_Price.js") with tag="京东比价", timeout=10, requires_body=true

[MitM]
hostname=in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com
[Script]
request if ${url} ~= /^https?:\/\/(api|zero-trust-client)\.cloudflareclient\.com\/(.*)\/reg\/[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$/i then script("https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.request.js") with tag="WARP Personal Request", requires_body=true
response if ${url} ~= /^https?:\/\/(api|zero-trust-client)\.cloudflareclient\.com\/(.*)\/reg\/[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$/i then script("https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.response.js") with tag="WARP Personal Response", requires_body=true
request if ${url} ~= /^https?:\/\/(api|zero-trust-client)\.cloudflareclient\.com\/(.*)\/reg\/t\.[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$/i then script("https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.request.js") with tag="WARP Teams Request", requires_body=true
response if ${url} ~= /^https?:\/\/(api|zero-trust-client)\.cloudflareclient\.com\/(.*)\/reg\/t\.[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$/i then script("https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.response.js") with tag="WARP Teams Response", requires_body=true

[MitM]
hostname=api.cloudflareclient.com, zero-trust-client.cloudflareclient.com
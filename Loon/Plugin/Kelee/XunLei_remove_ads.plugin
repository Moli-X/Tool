[Rewrite]
^https:\/\/api-shoulei-ssl\.xunlei\.com\/flowhub\/v1\/slots:batchGet$ reject-dict

[Script]
http-response ^https:\/\/conf-m-ssl\.xunlei\.com\/external\/ script-path=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/XunLei_remove_ads.js, requires-body=true, tag=精简我的页面

[MitM]
hostname=api-shoulei-ssl.xunlei.com, conf-m-ssl.xunlei.com
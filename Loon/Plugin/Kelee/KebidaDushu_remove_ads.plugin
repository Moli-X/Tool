response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/fs-member\/user\/profile\/v100\/detail/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/KebidaDushu_remove_ads.js") with tag="帆书去广告", requires_body=true
response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/chief-orch\/home\/bookPortal\/v111\/forApp/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/KebidaDushu_remove_ads.js") with tag="帆书去广告", requires_body=true
response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/sns-orchestration-system\/homePage\/api\/v100\/myPage/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/KebidaDushu_remove_ads.js") with tag="帆书去广告", requires_body=true
response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/task-orchestration\/taskCenter\/api\/v101\/taskList/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/KebidaDushu_remove_ads.js") with tag="帆书去广告", requires_body=true
response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/resource-orchestration-system\/book\/v101\/content/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/KebidaDushu_remove_ads.js") with tag="帆书去广告", requires_body=true
response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/user-orchestration\/user\/api\/v101\/ceiltip/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/KebidaDushu_remove_ads.js") with tag="帆书去广告", requires_body=true


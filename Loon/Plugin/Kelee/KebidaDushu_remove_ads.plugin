[Rewrite]
request if ${url} ~= /^https?:\/\/popup\.dushu365\.com\/api\/v2\/sfo\/(user_)?popup_(config|display)s/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/chief-orch\/config\/config\/v\d+\/(shortCut|appUpdateUnite|loadingAd)/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/fs-retain\/trialVip\/v\d+\/requestTrialVipPopDoNotSendReward/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/resource-orchestration-system\/vipLandingPage\/v\d+\/getVipLandingPageApp/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/fandeng-orch\/dual2211\/config/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/fdtalk-orch\/newcomerzone\/v\d+\/guide/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/fandeng-orch\/bookboy\/v\d+\/vipPagePop/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/chief-orch\/config\/config\/v\d+\/appConfig/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/order-orchestration\/orderWeb\/exchange\/v100\/showExchangeButton/i then reject(404)

[Script]
response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/chief-orch\/home\/bookPortal\/v105\/category/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/KebidaDushu_remove_ads.js") with tag="帆书去广告", requires_body=true

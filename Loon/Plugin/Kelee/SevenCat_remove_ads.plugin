#!name=七猫小说去广告
#!desc=移除大部分七猫小说广告，但受限于七猫小说自身对MitM和VPN状态的检测，部分页面广告无法移除。
#App链接=https://apps.apple.com/app/id1387717110
#!author=可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/SevenCat_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/SevenCat.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN, cdn-ad.wtzw.com, REJECT
DOMAIN, cdn-new-ad.wtzw.com, REJECT
DOMAIN-SUFFIX, gdt.qq.com, REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/api-cfg\.wtzw\.com\/v\d\/splash\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-bc\.wtzw\.com\/api\/v4\/search\/dispose/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/book-store\/config/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/book-store\/push-book/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/operation/i then reject_dict(200)
request if ${url} ~= /^https:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\//i then reject(404)
request if ${url} ~= /^https:\/\/api-gw\.wtzw\.com\/welf\/app\/v\d\/task\/red-packet/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cdn\.wtzw\.com\/bookimg\/free\/api\/v\d\/reader\/reader-copy-paragraph-all\.json/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api-cfg\.wtzw\.com\/v\d\/reward\//i then reject(404)
request if ${url} ~= /^https:\/\/api-cfg\.wtzw\.com\/v\d\/adv\//i then reject(404)
request if ${url} ~= /^https:\/\/api-cfg\.wtzw\.com\/v\d\/offline-adv\/index/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-cfg\.wtzw\.com\/v\d\/operation\/index\?ad_personal_switch/i then reject_dict(200)
request if ${url} ~= /^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/withdraw\/init/i then reject_dict(200)

response if ${url} ~= /^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/user\/my-center\?/i then response.json.delete(["data.func_area[1]", "data.func_area[2]"])

[MitM]
hostname=api-cfg.wtzw.com, sf3-fe-tos.pglstatp-toutiao.com, api-bc.wtzw.com, api-gw.wtzw.com, cdn.wtzw.com
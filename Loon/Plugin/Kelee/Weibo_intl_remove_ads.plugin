#!name=微博轻享版去广告
#!desc=移除开屏广告、时间线广告及评论区广告，移除发现页面横幅推广、最常访问、主页访客及热门视频，移除搜索填充词。
#App链接=https://apps.apple.com/app/id1215210046
#!author=可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Weibo_intl_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weibo_intl.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/bootpreload\.uve\.weibo\.com\/v1\/ad\/preload$/i then reject_dict(200)

response if ${url} ~= /^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends/i then response.json.delete(["data.banner", "data.user_footprint", "data.profile_accessrecord", "data.native_content"])
response if ${url} ~= /^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends/i then response.json.jq(".data.discover |= map(select(.schema != \"尊享会员\"))")

request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/cardlist\?v_f=2/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/ad\//i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/friends\/timeline$/i then response.json.delete(["advertises", "ad", "ad_version_2_weibo"])
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/friends\/timeline$/i then response.json.jq(".statuses|=map(select(.ad_marked!=true))")

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/unread_hot_timeline$/i then response.json.delete(["ad", "ad_version_2_weibo"])
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/unread_hot_timeline$/i then response.json.jq(".statuses|=map(select(.ad_marked!=true))")

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/comments\/build_comments\?/i then response.json.jq(".datas[].data.ad_from_comment? = true")

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/container_detail\?/i then response.json.jq(".pageHeader.data.items |= (if . == null then [] else map(select(.data.itemid != \"top_searching\")) end)")

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/cardlist\?aid=/i then response.json.jq(".cards |= map(select((.mblog?|(.ad_marked?|type==\"boolean\")and.ad_marked==true)or(.card_group?|type==\"array\"and any(.[]?;.mblog?|(.ad_marked?|type==\"boolean\")and.ad_marked==true))|not))")

request if ${url} ~= /^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=get_searching_info/i then reject_dict(200)

response if ${url} ~= /^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?/i then response.json.jq(".data.cards |= map(.items |= map(if .type == \"personal_vip\" then .right_text = \"\" else . end))")

[MitM]
hostname=bootpreload.uve.weibo.com, weibointl.api.weibo.cn, api.weibo.cn
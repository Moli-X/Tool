#!name=快看漫画去广告
#!desc=移除开屏广告、悬浮窗、漫画广告、社区广告、各类弹窗，精简顶部标签、我的页面。
#App链接=https://apps.apple.com/app/id906936224
#!author=可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/KuaiKanComic_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KuaiKanComic.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN, ad.v3mh.com, REJECT
DOMAIN, ipv6.kkmh.com, REJECT
DOMAIN, ipv4.kkmh.com, REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/(cdn-)?api\.kkmh\.com\/v\d\/ad\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/(cdn-)?h5\.kuaikanmanhua\.com\/user\/scene\/api\/new_user\/sign_in\/list/i then reject_dict(200)

request if ${url} ~= /^https:\/\/(cdn-)?api\.kkmh\.com\/v\d\/business\/activities\/get/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(cdn-)?api\.kkmh\.com\/v\d\/business\/mine\/business_config/i then reject_dict(200)

request if ${url} ~= /^https:\/\/(cdn-)?topic\.kkmh\.com\/gamecard\/v\d\/activityModule\/userSignInInfo\?activitySignInConfigId/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(cdn-)?topic\.kkmh\.com\/gamecard\/v\d\/activityModule\/fetchButtonInfo\?buttonConfigId/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(cdn-)?topic\.kkmh\.com\/gamecard\/v\d\/activityText\/getUserActivityTextInfo\?activityTextConfigId/i then reject_dict(200)

request if ${url} ~= /^https:\/\/(cdn-)?pay\.kkmh\.com\/v\d\/kb\/comic_page_banner\/detail/i then reject_dict(200)

request if ${url} ~= /^https:\/\/(cdn-)?api\.kkmh\.com\/v\d\/business\/fake_push\/info/i then reject_dict(200)

request if ${url} ~= /^https:\/\/(cdn-)?shop\.kkmh\.com\/mbff\/popup_administration\/page_management_popup_administration$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/(cdn-)?api\.kkmh\.com\/v\d\/business\/mine\/business_config/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(cdn-)?pay\.kkmh\.com\/v\d\/vip\/banner_tip_list/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(cdn-)?pay\.kkmh\.com\/v\d\/vip\/charge_tip_list/i then reject_dict(200)
request if ${url} ~= /^https:\/\/h5\.kuaikanmanhua\.com\/v\d\/kb\/recharge_good\/list_h5/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(cdn-)?pay\.kkmh\.com\/v\d\/kb\/wallet/i then reject_dict(200)

request if ${url} ~= /^https:\/\/(cdn-)?api\.kkmh\.com\/v\d\/checkin\/api\/new_user\/tab_info$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/h5\.kuaikanmanhua\.com\/game-h5\/new-user-welfare\/index\.html/i then reject(200)

request if ${url} ~= /^https:\/\/(cdn-)?pay\.kkmh\.com\/v\d\/vip\/platform_base\/popups_display$/i then reject_dict(200)


request if ${url} ~= /^https:\/\/(cdn-)?api\.kkmh\.com\/v\d\/checkin\/task_center\/get_by_task_type/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/(cdn-)?api\.kkmh\.com\/v\d\/ironman\/comic\/recommend/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/KuaiKanComic_remove_ads.js") with tag="修改广告参数", requires_body=true

response if ${url} ~= /^https:\/\/(cdn-)?api\.kkmh\.com\/v\d\/ironman\/discovery_v\d\/tab_list_v\d/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/KuaiKanComic_remove_ads.js") with tag="精简首页热门标签", requires_body=true

response if ${url} ~= /^https:\/\/(cdn-)?social\.kkmh\.com\/v\d\/graph\/homepage\/comicVideo\/v\d\/configs/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/KuaiKanComic_remove_ads.js") with tag="精简社区标签", requires_body=true

response if ${url} ~= /^https:\/\/(cdn-)?social\.kkmh\.com\/v\d\/graph\/unified_feed$/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/KuaiKanComic_remove_ads.js") with tag="精简社区信息流", requires_body=true

[MitM]
hostname=api.kkmh.com, cdn-api.kkmh.com, social.kkmh.com, cdn-social.kkmh.com, h5.kuaikanmanhua.com, cdn-h5.kuaikanmanhua.com, pay.kkmh.com, cdn-pay.kkmh.com, shop.kkmh.com, cdn-shop.kkmh.com, topic.kkmh.com, cdn-topic.kkmh.com
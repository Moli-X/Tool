#!name=风鸟去广告
#!desc=移除首页信息流和轮播图
#App链接=https://apps.apple.com/app/id1528682937
#!author=可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/RiskBird_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/RiskBird.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/user\/getBannerList/i then reject_dict(200)

request if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/searchHotEnt/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/query\/person\/personRecommend/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RiskBird_remove_ads.js") with tag="移除推荐老板", requires_body=true

[MitM]
hostname=m.riskbird.com
[Rewrite]
^https:\/\/m\.riskbird\.com\/prod-qbb-api\/user\/getBannerList reject-dict
^https:\/\/m\.riskbird\.com\/prod-qbb-api\/searchHotEnt reject-dict

[Script]
http-response ^https:\/\/m\.riskbird\.com\/prod-qbb-api\/query\/person\/personRecommend script-path=https://github.com/Moli-X/Tool/raw/X/Loon/Script/Kelee/RiskBird_remove_ads.js,requires-body=true,tag=移除推荐老板

[MitM]
hostname=m.riskbird.com
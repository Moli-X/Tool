#!name=滴滴去广告
#!desc=移除开屏广告、弹窗广告、横幅推广，精简我的页面。
#App链接=https://apps.apple.com/app/id554499054
#!author=可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.4.0(962)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/DiDi_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DiDi.png
#!date=2026-09-03 16:19:24

[Rule]
DOMAIN, gwp.xiaojukeji.com, REJECT
DOMAIN, gwpgz.diditaxi.com.cn, REJECT

DOMAIN, adtrack.xiaojukeji.com, REJECT

[Rewrite]
^https:\/\/as\.xiaojukeji\.com\/ep\/as\/toggles\? response-body-json-jq '.data |= map(select(.name != "isUseNetConnectivity"))'

^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/slow\? response-body-json-del data.order_cards.new_loss_banner_card data.order_cards.call_car_card_80

^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/core\? response-body-json-jq '.data.order_cards.nav_list_card.data |= map(select(.nav_id == "dache_anycar" or .nav_id == "carmate" or .nav_id == "driverservice" or .nav_id == "zhandianbashi" or .nav_id == "yuancheng" or .nav_id == "pincheche" or .nav_id == "bike" or .nav_id == "special_ride" or .nav_id == "nav_more_v3")) | .data.disorder_cards.top_nav_list.data.top_nav_info |= map(select(.nav_id == "chu_xing" or .nav_id == "freight_cargo"))'

^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/fast\? response-body-json-del data.disorder_cards.communicate_card data.disorder_cards.not_login_bottom_bar data.disorder_cards.riding_code_card data.order_cards data.disorder_cards.car_icon.data.icon_info_new_agreement

^https:\/\/common\.diditaxi\.com\.cn\/common\/v\d\/usercenter\/layout$ response-body-json-jq '.data |= (.instances |= (to_entries | map(select(.key as $k | ["center_base_info_card", "center_tool_card", "center_wallet_finance_card", "center_order_related_card"] | index($k))) | from_entries)) | .data.instances.center_wallet_finance_card.data.view_info |= map(select(.title == "优惠卡券"))'

^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget\? reject-dict
^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget$ reject-dict

^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/fast\? response-body-json-del data.disorder_cards.guess_card data.disorder_cards.scene_list_card

^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/dache_homepage_layout\? response-body-json-del data.instances.dache_main_core_icon

^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/dache_homepage_layout\? response-body-json-jq '.data |= (.instances |= (to_entries | map(select(.key | test("feed_back_|dache_main_member|order_container_|dache_main_core_icon|dache_main_card_"))) | from_entries))'

^https:\/\/api\.udache\.com\/intercity\/ticket\/api\/v\d\/core\/getFullPageInfoLayout\? response-body-json-jq '.data.disorder_components |= (map(select(.name == "history_order_card" or .name == "inprogress_order_card" or .name == "station_calendar" or .name == "main_card_v2" or .name == "user_history_order")))'

^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=prado\.cms\.delivery\.batch reject-dict

^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=prado\.cms\.AggregateDeliveryRemoteService\.aggregateDelivery reject-dict

^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.apolloConfig response-body-json-jq '.data |= map(select(.name != "daijia-memberInfo-config" and .name != "daijia-transfer-share-config"))'

^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.c\.p\.queryLevelAndRightsStatus reject-dict

^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.p\.popup reject-dict

^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.apolloToggle response-body-json-jq '.data |= map(select(.name as $n | {daijia_app_estimate_pre_req_switch:true,daijia_agent_car_picture_check:true,daijia_bluetooth_wifi_degrade_switch:true,daijia_weixin_publish_login:true,daijia_estimate_recommend_degrade_switch:true,daijia_yugu_policy_switch:true,daijia_home_location_guide_switch:true,daijia_estimate_switch:true} | has($n)))'

^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/bronze\/pinchengle_homepage_layout$ response-body-json-jq '.data.instances |= with_entries(select(.key | IN("dacheanycar-certificates-1", "main-card-1", "map-1", "nav-1", "tool-container-1")))'

^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/pSFCHomePage\? reject-dict

^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/SFCHomeTab\? response-body-json-jq '.data.tab_list |= map(select(.tab_id == "passenger" or .tab_id == "driver"))'

^https:\/\/htwkop-st\.xiaojukeji\.com\/gateway\?api=cms\.htw\.delivery\.batch reject-dict

^https:\/\/htwkop\.xiaojukeji\.com(:443)?\/gateway\?api=hm\.fa\.querySellCardSummary response-body-json-replace data {}

^https:\/\/htwkop\.xiaojukeji\.com(:443)?\/gateway\?api=hm\.fa\.queryWelfareCenter response-body-json-replace data {}

^https:\/\/freight\.xiaojukeji\.com\/gateway\?api=freight\.d\.core\.multiDisplayV\d reject-dict

^https:\/\/poi\.map\.xiaojukeji\.com\/mapapi\/startinfo\?api_version response-body-json-del rec_destination
^https:\/\/poi\.map\.xiaojukeji\.com\/mapapi\/poiinfo\?product_id response-body-json-del rec_destination

^https:\/\/common\.diditaxi\.com\.cn\/user_common\/itineraryList\? response-body-json-jq 'del(.data.tab_nav[]?.tab_param)'


[MitM]
hostname=as.xiaojukeji.com, conf.diditaxi.com.cn, common.diditaxi.com.cn, res.xiaojukeji.com, api.udache.com, daijia.kuaidadi.com, htwkop-st.xiaojukeji.com, htwkop.xiaojukeji.com, freight.xiaojukeji.com, poi.map.xiaojukeji.com
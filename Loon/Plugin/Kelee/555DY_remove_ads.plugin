[Rewrite]
^https:\/\/app-v1\.ecoliving168\.com\/api\/v1\/advert\/config reject-dict

[Script]
http-response ^https:\/\/app-v1\.ecoliving168\.com\/api\/v1\/movie\/index_recommend\? script-path=https://kelee.one/Resource/Script/555DY/555DY_remove_ads.js,requires-body=true,tag=移除横幅广告

[MitM]
hostname=app-v1.ecoliving168.com
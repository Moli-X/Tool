#!name=朴朴超市去广告
#!desc=移除超市去开屏广告，移除首页顶部轮播图和图标广告、启动小弹图广告、首页右下角悬浮动画、搜索热搜榜、搜索建议词、搜索发现热词、订单页面商，精简我的页面。
#App链接=https://apps.apple.com/app/id1144025167
#!author=kelv1n1n[https://github.com/kelv1n1n], 可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/PuPuMall_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PuPuMall.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/account\/discount\/order/i then reject(404)
request if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7\?position_types=100/i then reject(404)

[Script]
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/PuPuMall_remove_ads.js") with tag="移除朴朴超市广告", requires_body=true
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/search_component_banner/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/PuPuMall_remove_ads.js") with tag="移除朴朴超市广告", requires_body=true
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/search\/hot_keywords\/v3/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/PuPuMall_remove_ads.js") with tag="移除朴朴超市广告", requires_body=true
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/app_resource\/resource_preload\/list_h5_resource/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/PuPuMall_remove_ads.js") with tag="移除朴朴超市广告", requires_body=true
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/recommendation\/interests\/products/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/PuPuMall_remove_ads.js") with tag="移除朴朴超市广告", requires_body=true
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/v1/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/PuPuMall_remove_ads.js") with tag="移除朴朴超市广告", requires_body=true

[MitM]
hostname=j1.pupuapi.com
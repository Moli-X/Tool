#!date=2024-11-28 00:00:00

[Rule]
URL-REGEX,"^http:\/\/54\.222\.159\.138:8053\/httpdns\/",REJECT
URL-REGEX,"^http:\/\/101\.42\.130\.147:8053\/httpdns\/",REJECT
URL-REGEX,"^http:\/\/106\.55\.220\.18:8053\/httpdns\/",REJECT
URL-REGEX,"^http:\/\/139\.196\.12\.179:8053\/httpdns\/",REJECT

[Rewrite]
^https:\/\/j1\.pupuapi\.com\/client\/account\/discount\/order reject
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7\?position_types=100 reject

[Script]
http-response ^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7 script-path=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script//PuPuMall_remove_ads.js,requires-body=true,tag=移除朴朴超市广告
http-response ^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/search_component_banner script-path=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script//PuPuMall_remove_ads.js,requires-body=true,tag=移除朴朴超市广告
http-response ^https:\/\/j1\.pupuapi\.com\/client\/search\/hot_keywords\/v3 script-path=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script//PuPuMall_remove_ads.js,requires-body=true,tag=移除朴朴超市广告
http-response ^https:\/\/j1\.pupuapi\.com\/client\/app_resource\/resource_preload\/list_h5_resource script-path=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script//PuPuMall_remove_ads.js,requires-body=true,tag=移除朴朴超市广告
http-response ^https:\/\/j1\.pupuapi\.com\/client\/recommendation\/interests\/products script-path=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script//PuPuMall_remove_ads.js,requires-body=true,tag=移除朴朴超市广告
http-response ^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/v1 script-path=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script//PuPuMall_remove_ads.js,requires-body=true,tag=移除朴朴超市广告

[MitM]
hostname=j1.pupuapi.com
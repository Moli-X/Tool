#!name=剑网三无界去广告
#!desc=移除热门推送活动，并解决无法在Loon运行时更新和登录的问题。
#App链接=https://apps.apple.com/app/id1002355194
#!author=可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=iOS, iPadOS, macOS
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/SeasunJX3_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/SeasunJX3.png
#!date=2026-10-02 13:57:49

[General]
real-ip=*-update.xoyocdn.com, xg-flow.xoyo.com

[Rewrite]
request if ${url} ~= /^https:\/\/jx3comm\.xoyocdn\.com\/jx3gc\/zhcn\/login_ad\/WebCareer\/WebCareerTab\.txt/i then reject(404)

[MitM]
hostname=jx3comm.xoyocdn.com
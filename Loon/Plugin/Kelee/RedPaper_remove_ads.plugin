#!name=小红书去广告
#!desc=过滤信息流推广，移除图片及视频水印，如有异常，请先清除缓存再尝试。
#App链接=https://apps.apple.com/app/id741292507
#!author=RuCu6[https://github.com/RuCu6], fmz200[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/RedPaper_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/RedPaper.png
#!date=2026-10-02 13:57:49

[Rule]
AND, ((PROTOCOL, QUIC), (DOMAIN-SUFFIX, xiaohongshu.com)), REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/ci\.xiaohongshu\.com\/system_config\/watermark/i then reject_img(200)

request if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/guide\/user_banner|v3\/note\/guide)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.xiaohongshu\.com\/api\/sns\/(?:v1\/ads\/resource|v2\/hey\/\w+\/hey_gallery)/i then reject_dict(200)

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/banner_list$/i then response.json.replace("data", "{}")
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/hot_list$/i then response.json.replace("data.items", "[]")
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/hint/i then response.json.replace("data.hint_words", "[]")
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/trending\?/i then response.json.replace(["data.queries", "data.hint_word"], ["[]", "{}"])

[Script]
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/(?:imagefeed|live_photo\/save)/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RedPaper_remove_ads.js") with tag="移除图片和实况照片水印", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system\/service\/ui\/config\?/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RedPaper_remove_ads.js") with tag="移除整体配置 ui", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system_service\/config\?/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RedPaper_remove_ads.js") with tag="移除开屏广告 config", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/system_service\/splash_config/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RedPaper_remove_ads.js") with tag="移除开屏广告 splash_config", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/(?:note\/widgets|user\/followings\/followfeed)/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RedPaper_remove_ads.js") with tag="移除详情页小部件、关注页感兴趣的人", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/followfeed\?/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RedPaper_remove_ads.js") with tag="移除信息流广告", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v5\/recommend\/user\/follow_recommend\?/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RedPaper_remove_ads.js") with tag="移除详情页感兴趣的人", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v1\/interaction\/comment\/video\/download|v5\/note\/comment\/list)/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RedPaper_remove_ads.js") with tag="移除评论区实况照片水印", requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/note\/feed|v3\/note\/videofeed)/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RedPaper_remove_ads.js") with tag="移除图片和视频水印", requires_body=true

response if ${url} ~= /^https:\/\/(?:edith|rec)\.xiaohongshu\.com\/api\/sns\/v6\/homefeed\?/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RedPaper_remove_ads.js") with tag="移除信息流广告", requires_body=true

response if ${url} ~= /^https:\/\/(?:edith|so)\.xiaohongshu\.com\/api\/sns\/v10\/search\/notes\?/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RedPaper_remove_ads.js") with tag="移除搜索页广告", requires_body=true

response if ${url} ~= /^https:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/(?:v4\/note\/videofeed|v10\/note\/video\/save)/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/RedPaper_remove_ads.js") with tag="移除视频水印", requires_body=true

[MitM]
hostname=ci.xiaohongshu.com, edith.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com, www.xiaohongshu.com
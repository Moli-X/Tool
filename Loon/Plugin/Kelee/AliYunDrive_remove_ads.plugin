#!name=阿里云盘去广告
#!desc=移除首页广告横幅、弹窗和顶部奖励。
#App链接=https://apps.apple.com/app/id1494661473
#!author=RuCu6[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/AliYunDrive_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/AliYunDrive.png
#!date=2026-10-02 13:57:49

[Rule]
IP-CIDR, 203.107.1.1/24, REJECT, no-resolve

[Rewrite]
request if ${url} ~= /^https:\/\/member\.alipan\.com\/v2\/activity\/sign_in_luckyBottle/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.alipan\.com\/adrive\/v1\/file\/getTopFolders/i then reject_dict(200)


[Script]
response if ${url} ~= /^https:\/\/(biz)?api\.alipan\.com\/apps\/v\d\/users?\/home\/(news|widgets)/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/AliYunDrive_remove_ads.js") with tag="移除阿里云盘广告", requires_body=true
response if ${url} ~= /^https:\/\/member\.alipan\.com\/v1\/users\/onboard_list/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/AliYunDrive_remove_ads.js") with tag="移除阿里云盘广告", requires_body=true

[MitM]
hostname=api.alipan.com, member.alipan.com, bizapi.alipan.com
#!name=Uki去广告
#!desc=移除开屏广告、应用内悬浮窗，各类横幅、信息流广告、搜索填充词、我的页面广告。
#App链接=https://apps.apple.com/app/id1298912284
#!author=可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Uki_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Uki.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/startInfo$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/indexBanner$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/getPopup/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/allPopUpConfig$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/advConf$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/user\/checkQTSheInsurance$/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/lover\/productList/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/Uki_remove_ads.js") with tag="移除匹配卡横幅", requires_body=true

response if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/closeFriend\/home/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/Uki_remove_ads.js") with tag="移除密友横幅", requires_body=true

response if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/party\/config$/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/Uki_remove_ads.js") with tag="移除娱乐页面横幅和悬浮窗配置", requires_body=true

response if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v1\/post\/fetchSearchRecommend$/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/Uki_remove_ads.js") with tag="移除广场搜索填充词", requires_body=true

[MitM]
hostname=api.chenlongtech.cn
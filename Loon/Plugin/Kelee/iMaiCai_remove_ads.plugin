#!name=小象超市去广告
#!desc=移除开屏广告、应用内弹窗、猜你想买、横幅推广和悬浮窗。
#App链接=https://apps.apple.com/app/id1444411068
#!author=可莉🅥[https://github.com/Moli-X/Tool/blob/X/Loon/Readme.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/iMaiCai_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/iMaiCai.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/mall\.meituan\.com\/api\/c\/homepage\/splash/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mall\.meituan\.com\/api\/c\/homepage\/bubble\/operate\/info/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mall\.meituan\.com\/api\/c\/jigsaw\/code\/category-banner-\d+\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/mall\.meituan\.com\/api\/c\/poi\/\d+\/order\/recommend\/v\d/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mall\.meituan\.com\/api\/c\/banner\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/mall\.meituan\.com\/api\/c\/poi\/\d+\/personal\/recommend/i then reject_dict(200)
request if ${url} ~= /^https:\/\/businessapi\.ksedt\.com\/signupindex\/jxlist/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/portal-portm\.meituan\.com\/horn_ios\/mergeRequest/i then script("https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/iMaiCai_remove_ads.js") with tag="移除下发广告", requires_body=true

[MitM]
hostname=portal-portm.meituan.com, mall.meituan.com, businessapi.ksedt.com